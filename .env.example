SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000
NEXT_PUBLIC_VISITOR_URL=http://localhost:3000
DATABASE_URL=

# Reconstruction (image mode is default). NEXT_PUBLIC_ mirrors for client UI.
RECONSTRUCTION_MODE=image
NEXT_PUBLIC_RECONSTRUCTION_MODE=image
RECONSTRUCTION_PROVIDER=cloudflare
RECONSTRUCTION_MOCK=0
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional — switch RECONSTRUCTION_PROVIDER=openai to use this stub
OPENAI_API_KEY=

# Visitor camera overlay blend: opacity (default) or screen (wireframe-on-black)
OVERLAY_BLEND=opacity
NEXT_PUBLIC_OVERLAY_BLEND=opacity
